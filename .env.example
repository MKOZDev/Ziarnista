# Copy to .env and adjust if needed: cp .env.example .env

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=ziarnista
POSTGRES_PASSWORD=ziarnista
POSTGRES_DB=ziarnista
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ziarnista:ziarnista@localhost:5432/ziarnista?schema=public

# --- API (apps/api) ---
API_PORT=4000

# --- Frontends (apps/storefront, apps/admin) ---
# NestJS origin used by the Next.js /api/* rewrites (BFF). Server-only, never exposed to the browser.
API_URL=http://localhost:4000

# --- MinIO / S3 storage (docker-compose) ---
MINIO_ROOT_USER=ziarnista
MINIO_ROOT_PASSWORD=ziarnista-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# S3 client config used by the API (MinIO locally, Cloudflare R2 in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=ziarnista
S3_SECRET_ACCESS_KEY=ziarnista-secret
S3_BUCKET=ziarnista-products
