{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No "type": "module" in package.json, so NodeNext emits CommonJS (consumable by NestJS and Next.js)
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "types": []
  },
  "include": ["src"]
}
