{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Internal package without a build step: the consuming bundler compiles the sources
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": ["src"]
}
